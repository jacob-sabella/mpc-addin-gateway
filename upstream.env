# The Caddy release this addin ships. Nothing of it is in this repo: tools/fetch-upstream.sh downloads the release
# tarball for each CPU and the licence at build time and refuses them unless they match these hashes. The Upstream
# workflow (tools/upstream-check.sh) opens a pull request that moves these lines to a newer stable release.
CADDY_REPO=caddyserver/caddy
CADDY_TAG=v2.11.9
CADDY_SHA256_ARMV7=8c191dd2688c30dbe19793a0a3f532ede64547c5a70a47eebf7d8ab43a4d7514
CADDY_SHA256_ARM64=5e377cff994fc9362a6fcf695c53f226cfca3a3ef85bd3a3687cf252d6310165
CADDY_SHA256_LICENSE=cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30
